# === Mesherra configuration ===
# Copy this file to .env for local development. .env is gitignored.
# All required values MUST be set; the application fails fast at startup if
# any required variable is missing (no silent defaults that pretend to work).

# --- Application ---
MESHERRA_ENV=development                  # development | staging | production
MESHERRA_LOG_LEVEL=info                   # debug | info | warning | error
MESHERRA_SERVICE_HOST=0.0.0.0
MESHERRA_SERVICE_PORT=8000

# --- Identity & crypto ---
# Ed25519 keypair for this principal. Generate locally; never commit private keys.
MESHERRA_SIGNING_KEY_PATH=./local-secrets/signing.key
MESHERRA_PUBLIC_KEY_PATH=./local-secrets/signing.pub

# The verified directory this principal trusts as its identity root.
# Dev: same host as the main Mesherra service. Prod: separate subdomain
# (e.g., https://directory.<your-domain>).
# v0: Mesherra-hosted. Future: pluggable backend (PKI, web-of-trust, transparency log).
MESHERRA_DIRECTORY_BASE_URL=http://localhost:8000
MESHERRA_DIRECTORY_API_KEY=replace-me

# --- Storage ---
# v0: SQLite for local development; Postgres recommended for shared environments.
# All three stores can share an instance in dev; should be separate in production.
MESHERRA_POLICY_STORE_URL=sqlite:///./local-data/policy.db
MESHERRA_DIRECTORY_STORE_URL=sqlite:///./local-data/directory.db
MESHERRA_PROVENANCE_LEDGER_URL=sqlite:///./local-data/provenance.db

# --- Schema Registry ---
# Sibling service to Identity Directory. Holds signed schema definitions.
# Dev: same host as the main Mesherra service. Prod: separate subdomain
# (e.g., https://schemas.<your-domain>).
MESHERRA_SCHEMA_REGISTRY_URL=http://localhost:8000

# --- A2A integration ---
# The URL where this principal's AgentCard is published.
# Distinct from the Mesherra infra URL above; this is the agent's own endpoint.
# Dev: separate port from the Mesherra service. Prod: separate subdomain
# (e.g., https://agent.<your-domain>).
MESHERRA_A2A_BASE_URL=http://localhost:8001
MESHERRA_A2A_PEER_TIMEOUT_SECONDS=30

# --- Provenance ---
MESHERRA_PROVENANCE_HASH_ALGO=sha256
# JSON Canonicalization Scheme (RFC 8785) for byte-stable hashing.
MESHERRA_CANONICAL_JSON=jcs

# --- Replay defense (Phase 2 hardening per ARCH §11.1) ---
# Maximum acceptable difference (seconds) between a SendClaim's `timestamp`
# field and the inbound gateway's wall clock. Envelopes outside this window
# are rejected. The (sender_principal_id, nonce) seen-set is pruned to
# 2 × this value, which is the maximum lifetime of an envelope that could
# still pass the timestamp check on replay.
MESHERRA_CLOCK_SKEW_SECONDS=300

# --- Feature flags ---
MESHERRA_FEATURE_SCOPED_DISCLOSURE=false   # Phase 3 (ships last)
MESHERRA_FEATURE_IDENTITY_VERIFY=false     # Phase 2
MESHERRA_FEATURE_PROVENANCE=true           # Phase 1 (ships first)
