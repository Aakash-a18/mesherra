# === Tesherra configuration ===
# Copy this file to .env for local development. .env is gitignored.
# All required values MUST be set; the application fails fast at startup if
# any required variable is missing (no silent defaults that pretend to work).

# --- Application ---
TESHERRA_ENV=development                  # development | staging | production
TESHERRA_LOG_LEVEL=info                   # debug | info | warning | error
TESHERRA_SERVICE_HOST=0.0.0.0
TESHERRA_SERVICE_PORT=8000

# --- Identity & crypto ---
# Ed25519 keypair for this principal. Generate locally; never commit private keys.
TESHERRA_SIGNING_KEY_PATH=./local-secrets/signing.key
TESHERRA_PUBLIC_KEY_PATH=./local-secrets/signing.pub

# The verified directory this principal trusts as its identity root.
# Dev: same host as the main Tesherra service. Prod: separate subdomain
# (e.g., https://directory.<your-domain>).
# v0: Tesherra-hosted. Future: pluggable backend (PKI, web-of-trust, transparency log).
TESHERRA_DIRECTORY_BASE_URL=http://localhost:8000
TESHERRA_DIRECTORY_API_KEY=replace-me

# --- Storage ---
# v0: SQLite for local development; Postgres recommended for shared environments.
# All three stores can share an instance in dev; should be separate in production.
TESHERRA_POLICY_STORE_URL=sqlite:///./local-data/policy.db
TESHERRA_DIRECTORY_STORE_URL=sqlite:///./local-data/directory.db
TESHERRA_PROVENANCE_LEDGER_URL=sqlite:///./local-data/provenance.db

# --- Schema Registry ---
# Sibling service to Identity Directory. Holds signed schema definitions.
# Dev: same host as the main Tesherra service. Prod: separate subdomain
# (e.g., https://schemas.<your-domain>).
TESHERRA_SCHEMA_REGISTRY_URL=http://localhost:8000

# --- A2A integration ---
# The URL where this principal's AgentCard is published.
# Distinct from the Tesherra infra URL above; this is the agent's own endpoint.
# Dev: separate port from the Tesherra service. Prod: separate subdomain
# (e.g., https://agent.<your-domain>).
TESHERRA_A2A_BASE_URL=http://localhost:8001
TESHERRA_A2A_PEER_TIMEOUT_SECONDS=30

# --- Provenance ---
TESHERRA_PROVENANCE_HASH_ALGO=sha256
# JSON Canonicalization Scheme (RFC 8785) for byte-stable hashing.
TESHERRA_CANONICAL_JSON=jcs

# --- Feature flags ---
TESHERRA_FEATURE_SCOPED_DISCLOSURE=false   # Phase 3 (ships last)
TESHERRA_FEATURE_IDENTITY_VERIFY=false     # Phase 2
TESHERRA_FEATURE_PROVENANCE=true           # Phase 1 (ships first)
